# ---- Database ----------------------------------------------------------------------------
# Local SQLite file (created automatically). For many concurrent users / several app instances,
# point every instance at one libSQL server (sqld, see docker-compose.yml) or Turso:
#   DATABASE_URL="libsql://your-db.turso.io"   DATABASE_AUTH_TOKEN="..."
DATABASE_URL="file:data/variaq.db"
DATABASE_AUTH_TOKEN=""
# Optional page-level encryption of the local database file (libSQL). Set before first run;
# changing it later makes the existing file unreadable.
DATABASE_ENCRYPTION_KEY=""

# ---- Encryption --------------------------------------------------------------------------
# 32-byte master key (64 hex chars) that wraps each company's data-encryption key.
# `npm run setup` generates one. REQUIRED in production. Store it in a secrets manager and back
# it up: losing it makes encrypted fields (connector credentials, KRA PINs, auditor queries) unreadable.
VARIAQ_MASTER_KEY=""

# ---- App ---------------------------------------------------------------------------------
# Public URL of the app (invite links, server-action origin check).
APP_URL="http://localhost:3000"
# Session lifetime and idle timeout.
SESSION_DAYS="7"
SESSION_IDLE_MINUTES="480"
# Allow ERP connectors to reach private/on-premise network addresses (off by default — SSRF protection).
CONNECTOR_ALLOW_PRIVATE="0"
# Run the background job worker (connector syncs, scheduled engine runs) inside the web process.
# Set to 0 on web instances and run `npm run worker` separately when scaling out.
RUN_WORKER="1"

# ---- Variaq AI ---------------------------------------------------------------------------
# The AI service is configured by Variaq system administrators in the /admin console (model, key
# renewal, per-company allowances). The key entered there is stored encrypted in the database.
# ANTHROPIC_API_KEY here is only a fallback used when no key has been added in the console.
ANTHROPIC_API_KEY=""
# System administrators must use two-step verification to open /admin. Set to "0" ONLY for local development.
ADMIN_REQUIRE_MFA="1"
